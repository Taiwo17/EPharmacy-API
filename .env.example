# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epharmacy_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_TEST_NAME=epharmacy_test

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# --- OTP ---
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# --- File / Media storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=epharmacy-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL_BASE=

# --- Notifications ---
FCM_SERVER_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@medcart.app
SMS_PROVIDER_API_KEY=

# --- Payment gateways (fill in whichever is confirmed) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=

# --- ERP Adapter ---
ERP_SYNC_ENABLED=false
ERP_WEBHOOK_SECRET=change_me_erp_webhook_secret

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
